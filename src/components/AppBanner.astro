---
interface Props {
  contextText?: string;
}
const { contextText = 'Đọc offline, nhận thông báo im lặng mỗi sáng, thêm widget màn hình chính và đấu nối vế mượt mà hơn trên điện thoại.' } = Astro.props;
---

<aside class="cdv-card p-5 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
  <div class="flex items-center gap-3.5">
    <img src="/icons/app-icon.png" alt="Ứng dụng Lời Xưa" width="48" height="48" class="rounded-2xl shrink-0 shadow-sm" />
    <div>
      <p class="font-bold text-sm m-0">Trải nghiệm trọn vẹn trên ứng dụng Lời Xưa</p>
      <p class="text-xs m-0 mt-0.5" style="color: var(--cdv-text-secondary);">{contextText}</p>
    </div>
  </div>
  <div class="flex flex-wrap items-center gap-2 shrink-0 w-full lg:w-auto">
    <a
      href="https://apps.apple.com/app/apple-store/id6820905528?pt=128454365&ct=web&mt=8"
      target="_blank"
      rel="noopener noreferrer"
      data-track-app-click="ios"
      class="inline-flex items-center justify-center gap-2 px-3.5 py-2 rounded-lg text-xs font-semibold no-underline border transition-opacity hover:opacity-90 flex-1 sm:flex-initial"
      style="background-color: #111111; color: #FFFFFF; border-color: #2A2A2A;"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.85c.67-.82 1.13-1.96 1-3.1-.98.04-2.16.66-2.86 1.48-.61.71-1.15 1.87-.99 2.98 1.1.08 2.21-.57 2.85-1.36z"/>
      </svg>
      <span>App Store</span>
    </a>
    <a
      href="https://tmkstudio.io.vn/loixua-android"
      target="_blank"
      rel="noopener noreferrer"
      data-track-app-click="android"
      class="inline-flex items-center justify-center gap-2 px-3.5 py-2 rounded-lg text-xs font-semibold no-underline border transition-opacity hover:opacity-90 flex-1 sm:flex-initial"
      style="background-color: var(--cdv-elevated); color: var(--cdv-text); border-color: var(--cdv-border);"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="#00D2FF" d="M3.61 1.81L13.79 12 3.61 22.19a1.94 1.94 0 0 1-.61-1.39V3.2c0-.53.22-1.01.61-1.39z"/>
        <path fill="#00F076" d="M13.79 12L5.46 1.46l12.01 6.86-3.68 3.68z"/>
        <path fill="#FF3A44" d="M13.79 12l3.68 3.68-12.01 6.86L13.79 12z"/>
        <path fill="#FFD800" d="M17.47 8.32l3.52 2.01c.95.54.95 1.43 0 1.97l-3.52 2.02L13.79 12l3.68-3.68z"/>
      </svg>
      <span>CH Play</span>
    </a>
    <button
      type="button"
      data-open-app-popup
      class="cdv-btn-secondary text-xs"
      title="Hiện mã QR tải nhanh trên điện thoại"
    >
      Quét mã QR
    </button>
  </div>
</aside>

<script is:inline>
  document.querySelectorAll('[data-track-app-click]').forEach(function (el) {
    el.addEventListener('click', function () {
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'app_store_click', { platform: el.getAttribute('data-track-app-click') || 'unknown' });
      }
    });
  });
  document.querySelectorAll('[data-open-app-popup]').forEach(function (btn) {
    if (btn.dataset.boundAppPopup) return;
    btn.dataset.boundAppPopup = '1';
    btn.addEventListener('click', function () {
      window.dispatchEvent(new CustomEvent('loixua-open-app-popup'));
    });
  });
</script>
