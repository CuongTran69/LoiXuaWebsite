---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SettingsDialog from '@/components/SettingsDialog';
import CommandSearch from '@/components/CommandSearch';
import ZenMiniPlayer from '@/components/ZenMiniPlayer';
import AppDownloadDialog from '@/components/AppDownloadDialog';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  hideChrome?: boolean;
  hideMiniPlayer?: boolean;
  forceTheme?: 'dark';
}

const {
  title,
  description = 'Kho tàng 949+ ca dao, tục ngữ, thành ngữ Việt Nam có giải nghĩa chi tiết, giọng đọc studio, gieo quẻ, đố vui và đấu nối vế.',
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  jsonLd,
  hideChrome = false,
  hideMiniPlayer = false,
  forceTheme,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, 'https://loixua.tmkstudio.io.vn').toString();
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="vi" data-poem-align="center" data-force-theme={forceTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={forceTheme ?? 'light dark'} />
    <script is:inline define:vars={{ forceTheme }}>
      try {
        if (forceTheme === 'dark') {
          document.querySelector('meta[name="color-scheme"]').setAttribute('content', 'dark');
        } else {
          var s = localStorage.getItem('color-scheme');
          if (s === 'light' || s === 'dark') {
            document.querySelector('meta[name="color-scheme"]').setAttribute('content', s);
          }
        }
        var f = JSON.parse(localStorage.getItem('loixua.poem_font.v1') || '"newsreader"');
        var off = JSON.parse(localStorage.getItem('loixua.poem_font_offset.v1') || '0');
        var align = JSON.parse(localStorage.getItem('loixua.poem_align.v1') || '"center"');
        var map = {
          newsreader: '"Newsreader", Georgia, serif',
          serif: '"Newsreader", Georgia, serif',
          georgia: 'Georgia, "Times New Roman", serif',
          charter: 'Charter, "Bitstream Charter", Georgia, serif',
          palatino: '"Palatino Linotype", "Book Antiqua", Palatino, Georgia, serif',
          rounded: '"Be Vietnam Pro", system-ui, sans-serif'
        };
        document.documentElement.style.setProperty('--cdv-poem-font', map[f] || map.newsreader);
        if (typeof off === 'number') document.documentElement.style.setProperty('--cdv-poem-size-offset', off + 'px');
        if (align === 'left' || align === 'center' || align === 'right') {
          document.documentElement.setAttribute('data-poem-align', align);
          document.documentElement.style.setProperty('--cdv-poem-align', align);
        }
      } catch (e) {}
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="apple-itunes-app" content="app-id=6820905528" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&display=swap"
      rel="stylesheet"
    />

    <meta property="og:site_name" content="Lời Xưa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:image" content="https://loixua.tmkstudio.io.vn/icons/app-icon.png" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/icons/app-icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/app-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    {jsonLdList.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link visually-hidden">Bỏ qua điều hướng</a>

    {!hideChrome && <Header currentPath={Astro.url.pathname} hideZen={hideMiniPlayer} />}

    <main id="main-content" class={hideChrome ? 'flex-1' : 'flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 pb-16'}>
      <slot />
    </main>

    {!hideChrome && <Footer />}

    <SettingsDialog client:load />
    <CommandSearch client:load />
    <AppDownloadDialog client:load />
    {!hideMiniPlayer && <ZenMiniPlayer client:load />}

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
      if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
        import('@oddbird/popover-polyfill').catch(function () {});
      }
      document.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest('[data-open-app-popup]') : null;
        if (btn) {
          e.preventDefault();
          var more = document.getElementById('more-nav-menu');
          var site = document.getElementById('site-menu');
          if (more && typeof more.hidePopover === 'function') { try { more.hidePopover(); } catch (err) {} }
          if (site && typeof site.hidePopover === 'function') { try { site.hidePopover(); } catch (err) {} }
          window.dispatchEvent(new CustomEvent('loixua-open-app-popup'));
        }
      });
    </script>
  </body>
</html>
