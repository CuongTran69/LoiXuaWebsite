# Optional GA4 Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=

# Optional Firebase Web App App Check site key (Google Cloud Fraud Defense / reCAPTCHA Enterprise)
PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Optional provider override: "enterprise" (default, Fraud Defense) or "v3" (legacy Classic)
PUBLIC_FIREBASE_APP_CHECK_PROVIDER=

# Optional Firebase Web API Key & App ID overrides
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_APP_ID=
